<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy.

  Default posture: cleartext HTTP is DENIED. Dataset updates are signed with
  Ed25519 and are the only thing this app fetches over the network, but signing
  protects integrity, not confidentiality, and a signed payload replayed over an
  open network is still a downgrade risk. Release builds therefore require TLS.

  The one exception is the loopback family, which is used to reach a dataset
  server running on the developer machine:
    10.0.2.2   Android emulator alias for the host loopback
    127.0.0.1  device/emulator loopback
    localhost  same, by name

  Debug builds override this file with src/debug/res/xml/network_security_config.xml,
  which permits cleartext to any host so a physical device on a LAN can talk to a
  server running on a workstation.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
