<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of the release network security policy.

  Permits cleartext HTTP to any host so that a physical device on the same LAN
  can reach a dataset server running on a workstation at an address such as
  http://192.168.1.20:8000. This file is never packaged into a release build;
  app/src/main/res/xml/network_security_config.xml governs release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
