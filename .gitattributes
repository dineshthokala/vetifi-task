# Normalise line endings so a checkout on Windows produces a working Docker
# build. A CRLF entrypoint.sh fails in /bin/sh with "\r: command not found",
# and the failure appears at `docker compose up` rather than at build time.

* text=auto eol=lf

# These must never be CRLF: they are executed by a POSIX shell in the image.
*.sh text eol=lf
entrypoint.sh text eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary.
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.apk binary
*.jar binary
*.db binary

# Generated by Gradle, checked in by Flutter's template but regenerated.
app/android/**/gradle-wrapper.jar binary